* text=auto eol=lf
*.bat text eol=crlf
gradlew text eol=lf

# Binary assets
*.jpg binary
*.jpeg binary
*.png binary
*.heic binary
*.mp4 binary

# ML models via Git LFS (the reference set lives in a separate private repo, see docs/testdata.md)
*.onnx filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text

